# Configuración de Talleres Rueda (research R7).
# Copia este fichero a .env y ajusta los valores. El .env nunca se sube a git.
# Todos los valores de aquí son de ejemplo o ficticios (constitución, principio V).

# --- Base de datos (la usa docker-compose.yml para crear el contenedor) ---
POSTGRES_USER=taller
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=taller
DATABASE_URL=postgres://taller:cambiar-en-local@localhost:5432/taller

# --- Correo (en desarrollo, Mailpit: bandeja en http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
CORREO_REMITENTE="Talleres Rueda <taller@talleres-rueda.test>"

# Dirección con la que se construyen los enlaces que reciben los clientes
URL_PUBLICA=http://localhost:3000

# --- Valores del taller (valores demo del quickstart) ---
TALLER_CUPO_DIARIO=2
TALLER_PRECIO_HORA=40.00
TALLER_IVA_PORCENTAJE=21.00
TALLER_NOMBRE="Talleres Rueda"
# NIF y dirección ficticios
TALLER_NIF=B00000000
TALLER_DIRECCION="Calle Ejemplo 1, 03001 Alicante"

# --- Registro de actividad del servidor ---
RUST_LOG=info,taller=debug
